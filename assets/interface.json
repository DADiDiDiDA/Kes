                    "name": "成长",
                    "label": "🌱 成长",
                    "description": "单元币/主战员/辅战员升级材料",
                    "option": ["选择成长关卡"],
                    "pipeline_override": {
                        "开始选择刷什么类型关卡": {
                            "next": ["成长"]
                        }
                    }
