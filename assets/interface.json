{
    "interface_version": 2,
    "name": "Kes",
    "description": "Kes自动化脚本 - 只可以完成每日任务",
    "contact": "",
    "license": "MIT",
    "welcome": "",
    "version": "0.0.1",
    
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    
    "task": [
        {
            "name": "🎮 进入游戏",
            "entry": "启动游戏开始",
            "default_check": true,
            "description": "自动启动游戏或跳过启动直接开始",
            "option": ["是否需要启动游戏"]
        },
        {
            "name": "📧 邮件奖励领取",
            "entry": "领取邮件开始",
            "default_check": true,
            "description": "领取邮箱内所有奖励"
        },
        {
            "name": "☕喝咖啡",
            "entry": "喝咖啡开始",
            "default_check": true,
            "description": "喝杯咖啡吧~~"
        },
        {
            "name": "⚔️ 刷体力",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["选择刷什么类型关卡"],
            "description": "选择要刷取的关卡类型及具体关卡"
        },
        {
            "name": "📜 政策审阅",
            "entry": "政策审阅开始",
            "default_check": true,
            "description": "自动完成政策审阅并领取周期奖励"
        },
        {
            "name": "📋 领取日常奖励",
            "entry": "领取日常奖励开始",
            "default_check": true,
            "description": "领取日常任务奖励"
        },
        {
            "name": "🎫 领取补给奖励",
            "entry": "领取补给奖励开始",
            "default_check": true,
            "description": "领取补给界面中的可领取奖励（补给任务及等级奖励）"
        }
    ],
    
    "option": {
        "是否需要启动游戏": {
            "type": "select",
            "label": "是否需要启动游戏",
            "description": "选择是否自动启动游戏客户端",
            "default_case": "启动游戏",
            "cases": [
                {
                    "name": "启动游戏",
                    "label": "🚀 启动游戏",
                    "description": "自动启动游戏客户端",
                    "pipeline_override": {
                        "启动游戏开始": {
                            "next": ["启动游戏"]
                        }
                    }
                },
                {
                    "name": "跳过启动",
                    "label": "⏭️ 跳过启动",
                    "description": "不启动游戏，直接开始后续任务（适用于模拟器已启动游戏）",
                    "pipeline_override": {
                        "启动游戏开始": {
                            "next": ["无需启动游戏"]
                        }
                    }
                }
            ]
        },

        "选择刷什么类型关卡": {
            "type": "select",
            "label": "选择刷什么类型关卡",
            "description": "选择要刷取的关卡类型",
            "default_case": "成长",
            "cases": [
